# Copy to .env and fill in only what you use. .env is gitignored.
# Tests and CI need none of these: they use the deterministic mock LLM provider.

# LLM provider for the triage agent: mock | ollama | groq | openai | anthropic
NETSENTRY_LLM_PROVIDER=mock

# Ollama (local, free). From WSL2 this needs networkingMode=mirrored, or point it at the Windows host IP.
OLLAMA_BASE_URL=http://localhost:11434

# Hosted providers (only needed when that provider is selected)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
